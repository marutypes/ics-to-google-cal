<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>ics_to_google_cal</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="5.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ics-to-google-cal.Tests/**/*.cs" />
    <None Remove="ics-to-google-cal.Tests/**/*" />
    <EmbeddedResource Remove="ics-to-google-cal.Tests/**/*" />
  </ItemGroup>

</Project>
